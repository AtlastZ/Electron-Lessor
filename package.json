{
  "name": "electron-lessor",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "echo \"Error: no test specified\" && exit 1",
    "clean": "rm -rf node_modules dist",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --win --mac --linux",
    "migrate": "NODE_ENV=development node src/database/migrate.js",
    "migrate:rollback": "NODE_ENV=development node src/database/migrate.js rollback",
    "seed": "NODE_ENV=development node src/database/seed.js",
    "db:create": "NODE_ENV=development node src/database/create.js",
    "db:reset": "yarn migrate:rollback && yarn migrate && yarn seed"
  },
  "license": "MIT",
  "packageManager": "yarn@4.8.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "electron": "^35.1.2",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.electron.lessor",
    "productName": "Electron Lessor",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "dependencies": {
    "sqlite3": "^5.1.7"
  }
}
